---
// ==========================================================================
// projects/index.astro — A REDIRECT PAGE.  (URL: /projects)
// --------------------------------------------------------------------------
// Every project is now listed in the "#projects" section of the one-page home
// (see src/pages/index.astro). This file only keeps the old /projects address
// alive so that a link or a search result does not end on a 404.
//
// IMPORTANT: it does NOT replace the individual project pages. Those are still
// at /projects/<file-name> and are built from src/projects/*.md by
// src/pages/projects/[id].astro. Only the *list* moved to the home page.
//
// You can delete this file once nothing links to /projects anymore.
// ==========================================================================
const target = '/#projects';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={target} />
		<meta name="robots" content="noindex" />
		<title>→ {target}</title>
	</head>
	<body>
		<p>
			Redirecting to <a href={target}>{target}</a>…
		</p>
	</body>
</html>
