---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
	<div class="content">
		<h2>Welcome</h2>
		<p>Little description</p>
		<p>List of projects</p>		
		<a href="/Books">Take a look at my projects</a>
	</div>
</BaseLayout>

<style>
	.content {
		text-align: center;
	}
	a {
		display: inline-block;
		background-color: #7a49c5;
		color: #fff;
		padding: 6px 10px;
		border-radius: 2px;
		text-decoration: none;
		margin-top: 20px;

		&:hover {
			background-color: #965ee9;
		}
	}
</style>