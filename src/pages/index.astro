---
// ==========================================================================
// index.astro — THE ONE PAGE of the site.  (URL: /)
// --------------------------------------------------------------------------
// One page, three sections, one after the other:
//
//   1. <Hero />            the first screen: your pictures/videos in the
//                          background, your name and your coordinates on top.
//                          It is not a <Section>: it is deliberately
//                          full-screen, with no title block.
//   2. <Section #about>    "Qui je suis": prose, studies, skills, links.
//   3. <Section #projects> every project, in a grid (or the draggable rail).
//
// The menu buttons of the header (Home / About / Projects) point at #home,
// #about and #projects, so they scroll to the right section of THIS page.
// Their labels and their targets are in src/site.ts (`menu`), the titles of the
// sections are in src/site.ts too (`sections`).
//
// Everything else kept its own page, because a one-page site cannot hold it:
//   /projects/<name>  one page per project (built from src/projects/*.md)
//   /cv               the CV (src/pages/cv.md)
//   /about and /projects now redirect to the matching section (astro.config.mjs)
// ==========================================================================
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import AboutSection from '../components/AboutSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import { listProjects } from '../project-list';
import { sections, siteName } from '../site';

// Already sorted, newest first. The terminal prints what was found every time.
const projects = await listProjects();
---

<BaseLayout
	title_fr={`${siteName} — Développeur moteur et gameplay`}
	title_en={`${siteName} — Engine and gameplay developer`}
>
	<!-- 1. THE HERO ------------------------------------------------------- -->
	<Hero />

	<!-- 2. PROJECTS ------------------------------------------------------- -->
	<Section
		id={sections.projects.id}
		eyebrow={sections.projects.eyebrow}
		title={sections.projects.title}
		lead={sections.projects.lead}
		tone="tint"
	>
		<ProjectsSection
			projects={projects}
			layout={sections.projects.layout}
			hint={sections.projects.hint}
		/>
	</Section>

	<!-- 3. ABOUT ----------------------------------------------------------
	     `tone="plain"`: white background. The next section is tinted, which is
	     what draws the line between them (see Section.astro). -->
	<Section
		id={sections.about.id}
		eyebrow={sections.about.eyebrow}
		title={sections.about.title}
		lead={sections.about.lead}
	>
		<AboutSection />
	</Section>
</BaseLayout>
