---
// ==========================================================================
// about.astro — A REDIRECT PAGE.  (URL: /about)
// --------------------------------------------------------------------------
// The about content is now the "#about" section of the one-page home
// (src/components/AboutSection.astro): writing it twice would mean maintaining
// it twice.
//
// This file stays for one reason only: an old link, a bookmark or a search
// result pointing at /about must not end on a 404. It sends the visitor to
// /#about (the section of the home page) and does nothing else.
//
// HOW THE REDIRECT WORKS on a static site (no server):
//   - <meta http-equiv="refresh"> is the oldest and most widely supported way
//     to redirect a page; it works on every host, including GitHub Pages;
//   - a real <a> link is kept for the rare visitor whose browser ignores it;
//   - `noindex` asks search engines to forget /about and index / instead.
//
// YOU CAN DELETE THIS FILE once nothing links to /about anymore (your CV, a
// PDF, a social profile...). The site does not depend on it.
// ==========================================================================
const target = '/#about';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={target} />
		<meta name="robots" content="noindex" />
		<title>→ {target}</title>
	</head>
	<body>
		<p>
			Redirecting to <a href={target}>{target}</a>…
		</p>
	</body>
</html>
