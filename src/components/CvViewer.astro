---
// ==========================================================================
// CvViewer.astro — your CV, shown on its own page (/cv).
// --------------------------------------------------------------------------
// Everything about the CV lives here now: the about page only carries the row
// of links, and the "Mon CV" link opens this page.
//
// Two display modes, chosen by `cvDisplay` in src/site.ts:
//
//   'image'  a plain picture of the CV (src/assets/cv.png by default).
//            No border, no toolbar, no scrollbar: nothing betrays a reader.
//            The frame is exactly as tall as the picture needs to be, and it
//            never moves or resizes on its own — it is just an <img>, sized
//            from the real proportions that Vite reads out of the file.
//            Best for a one-page CV.
//
//   'reader' the PDF itself, in the browser's built-in reader, with the
//            toolbar, the navigation panel and the scrollbar turned off and
//            no border. Best when the CV has several pages, because it can
//            scroll from one page to the next.
//            Note: Firefox refuses by default to show a PDF inside a frame on
//            a remote site; the "open in a new tab" link next to the frame
//            covers that.
//
// 'image' falls back to 'reader' automatically when there is no picture named
// cv.* in src/assets/, so the page is never empty.
//
// Both modes need the real PDF too (public/cv.pdf): it is what the download
// link gives to the visitor.
// ==========================================================================
import { cvPdf, cvImage, cvDisplay, cvReaderRatio } from '../site';

// 'image' mode with a picture available -> use its real proportions.
// Anything else -> reader mode with the ratio configured in src/site.ts.
const useImage = cvDisplay === 'image' && Boolean(cvImage);

// The frame gets its height from that ratio: width 100%, height = ratio%.
// Written as a CSS variable because a <style> block cannot contain a value
// computed in JavaScript.
---

{useImage ? (
    <img class="cv-page cv-page--image" src={cvImage.src} alt="CV" />
) : (
    /* In 'reader' mode the frame needs an imposed height, otherwise the
       browser's PDF reader grows without end. That height is `cvReaderRatio`
       (in src/site.ts): height = ratio% of the width, so 141.4% for an A4 page
       standing up. It is passed to the CSS as a variable. */
    <iframe
        class="cv-page cv-page--reader"
        style={`--cv-ratio: ${cvReaderRatio}`}
        src={`${cvPdf}#toolbar=0&navpanes=0&scrollbar=0&view=FitH`}
        title="CV (PDF)"
    />
)}

<style>
	/* ------------------------------------------------------------------
	   The frame. No border, no background, no shadow, no rounded corner:
	   the picture (or the reader) is all you see.

	   The height comes from the ratio computed above, which is what makes
	   it "fixed": it never depends on what the reader decides to show, and
	   it never jumps once loaded.
	   ------------------------------------------------------------------ */
	.cv-frame {
		position: relative;
		width: 100%;
		max-width: var(--w-column);
		margin: 0 auto;
		border: 0;
		background: transparent;
	}

	/* height = ratio% of the width, without any JavaScript. */
	.cv-frame::before {
		content: '';
		display: block;
		padding-top: var(--cv-ratio, 141.4%);
	}

	.cv-frame img,
	.cv-frame iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}

	/* The picture is sharp on a retina screen and never cropped. */
	.cv-frame img {
		object-fit: contain;
	}

	/* The reader must not show its own edges. */
	.cv-frame iframe {
		background: var(--c-surface);
		overflow: hidden;
	}

	/* On a phone the page is narrow, so the CV would become tiny: cap the
	   height instead and let the reader scroll inside. */
	@media (max-width: 640px) {
		.cv-frame--reader {
			max-height: 78vh;
		}
		.cv-frame--reader::before {
			padding-top: 0;
		}
		.cv-frame--reader iframe {
			position: static;
			height: 78vh;
		}
	}

    .cv-page {
		display: block;
		width: 100%;
		max-width: var(--w-column);
		margin: 0 auto;
		border: 0;
		background: transparent;
	}

	/* L'image apporte ses propres proportions : rien ne bouge au chargement. */
	.cv-page--image {
		height: auto;
	}

	/* The reader needs an imposed height: `100 / cvReaderRatio` is the
	   width/height ratio of the document (141.4 -> an A4 page standing up,
	   129.4 -> a US Letter page). Change `cvReaderRatio` in src/site.ts. */
	.cv-page--reader {
		aspect-ratio: 100 / var(--cv-ratio, 141.4);
		background: var(--c-surface);
		overflow: hidden;
	}

	@media (max-width: 640px) {
		.cv-page--reader {
			aspect-ratio: auto;
			height: 78vh;
		}
	}
</style>
