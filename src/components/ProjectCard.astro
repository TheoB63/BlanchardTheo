---
// ==========================================================================
// ProjectCard.astro — THE reusable project box.
// --------------------------------------------------------------------------
// Used in three places, always the same way:
//   - the horizontal rail of the home page (ProjectRail.astro)
//   - the grid of /projects
//   - nowhere else, but it would work anywhere
//
// It shows: the image, the name, a short summary and the tags (square chips).
// The whole card is a link to the project page, which is built from the .md
// file of the same name in src/projects/.
//
// Nothing is hard-coded here: everything comes from the frontmatter of the
// .md file (see src/content.config.ts for the list of fields).
//
// Props:
//   project : one entry of the "projects" collection
// ==========================================================================
import type { CollectionEntry } from 'astro:content';
import Bilingual from './Bilingual.astro';
import { tagLabel } from '../i18n/index';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title_fr, title_en, summary_fr, summary_en, alt_fr, alt_en, image, tags } = project.data;

// project.id is the file name without ".md", so the URL follows the file.
const url = `/projects/${project.id}`;

// An image imported through the `image()` schema helper is an object with
// .src / .width / .height. SVG files come through unchanged, so we only pass
// the size when we actually have one.
const alt = alt_en || alt_fr || title_en;
---

<article class="card">
	<a class="card-link" href={url}>
		<!-- Image (or a placeholder when the .md has no `image:` field) ----->
		<div class="card-media">
			{
				image ? (
					<img src={image.src} alt={alt} width={image.width} height={image.height} loading="lazy" />
				) : (
					<div class="card-noimg" aria-hidden="true">
						<Bilingual k="project.noImage" />
					</div>
				)
			}
		</div>

		<!-- Text ------------------------------------------------------------>
		<div class="card-body">
			<h3 class="card-title">
				<span lang="fr">{title_fr}</span>
				<span lang="en">{title_en}</span>
			</h3>

			<p class="card-summary">
				<span lang="fr">{summary_fr}</span>
				<span lang="en">{summary_en}</span>
			</p>

			<!-- Tags: square chips. One <li> per language so the whole row
			     switches at once. -->
			{
				tags.length > 0 && (
					<ul class="tags">
						<li lang="fr" class="tags-row">
							{tags.map((tag) => (
								<span class="tag">{tagLabel(tag, 'fr')}</span>
							))}
						</li>
						<li lang="en" class="tags-row">
							{tags.map((tag) => (
								<span class="tag">{tagLabel(tag, 'en')}</span>
							))}
						</li>
					</ul>
				)
			}
		</div>
	</a>
</article>

<style>
	.card {
		background: #fff;
		border: 1px solid #e6e0f2;
		border-radius: 4px;
		overflow: hidden;
		height: 100%;
	}

	.card:hover {
		border-color: #c9b8e8;
	}

	/* One link wraps the whole card: bigger click target, no nested links. */
	.card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.card-link:focus-visible {
		outline: 2px solid #7a49c5;
		outline-offset: 2px;
	}

	/* --- Image ----------------------------------------------------------- */
	.card-media {
		/* Every card has the same shape, whatever the size of your screenshot. */
		aspect-ratio: 16 / 10;
		background: #f9f6fc;
		border-bottom: 1px solid #e6e0f2;
		overflow: hidden;
	}

	.card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-noimg {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		color: #a9a2b8;
		font-size: 0.85rem;
	}

	/* --- Text ------------------------------------------------------------ */
	.card-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 14px 16px 16px;
		flex: 1;
	}

	.card-title {
		margin: 0;
		font-size: 1.15em;
		font-weight: 500;
		line-height: 1.3;
	}

	.card-summary {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 300;
		color: #6b6478;
		line-height: 1.5;
		/* Three lines max, so the cards of the rail stay aligned. */
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* --- Tags: SQUARE chips (border-radius: 3px, not pills) -------------- */
	.tags {
		list-style: none;
		margin: auto 0 0; /* pushed to the bottom of the card */
		padding: 0;
	}

	.tags-row {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.tag {
		display: inline-block;
		padding: 3px 8px;
		border: 1px solid #e0d8ef;
		border-radius: 3px;
		background: #f9f6fc;
		color: #6b6478;
		font-size: 0.78rem;
		line-height: 1.4;
	}
</style>
