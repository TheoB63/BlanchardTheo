---
// ==========================================================================
// ProjectRail.astro — the horizontal list of projects of the home page.
// --------------------------------------------------------------------------
// Three ways to move through the list, all handled below:
//   1. the two arrows UNDER the rail (‹ ›): exactly ONE project per click
//   2. drag with the mouse: press, hold, move sideways (grab and slide)
//   3. swipe with a finger (that one is free: it is just a scrollable div)
//
// The scrollbar is hidden: the arrows and the drag replace it.
//
// Cards stay clickable. The rule used below is simple and reliable: a press
// that moves less than 8 pixels is a click and opens the project; anything
// beyond that is a drag and the click is cancelled.
//
// The cards themselves are ProjectCard.astro — this component only lays them
// out in a row and adds the scrolling.
//
// Props:
//   projects : the entries to show (already sorted by the page)
// ==========================================================================
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { t } from '../i18n/index';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<div class="rail-block">
	<!-- The row of cards. `data-rail` is the hook used by the script below. -->
	<div class="rail" data-rail tabindex="0" role="group" aria-label={t('rail.label', 'en')}>
		{projects.map((project) => <ProjectCard project={project} />)}
	</div>

	<!-- The two arrows, BELOW the rail as requested. -->
	<div class="rail-controls">
		<button type="button" class="rail-btn" data-rail-prev aria-label={t('rail.scrollLeft', 'en')}>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
		</button>
		<button type="button" class="rail-btn" data-rail-next aria-label={t('rail.scrollRight', 'en')}>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
		</button>
	</div>
</div>

<script>
    /** How far the mouse may move and still count as a click, in pixels. */
    const CLICK_TOLERANCE = 8;

    /** Distance of the last drag. Shared by the rails and the click guard. */
    let lastDragDistance = 0;

    declare global {
        interface Window {
            __railClickGuard?: boolean;
        }
    }

    document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
        const block = rail.closest<HTMLElement>('.rail-block') ?? rail.parentElement!;
        const prev = block.querySelector<HTMLButtonElement>('[data-rail-prev]');
        const next = block.querySelector<HTMLButtonElement>('[data-rail-next]');
        const cards = () => Array.from(rail.children) as HTMLElement[];

        rail.addEventListener('dragstart', (e) => e.preventDefault());

        // --- 1. Keep the arrows in sync with the position ----------------
        function update() {
            const max = rail.scrollWidth - rail.clientWidth;
            const atStart = rail.scrollLeft <= 2;
            const atEnd = rail.scrollLeft >= max - 2;

            if (prev) prev.disabled = atStart;
            if (next) next.disabled = atEnd || max <= 2;
        }

        rail.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();

        // --- 2. The arrows: one project per click -------------------------
        function step(direction: number)
        {
            const list = cards();
            if (list.length === 0) return;
            
            const first = list[0];
            const firstOffset = first.offsetLeft;
            const gap = list.length > 1 ? list[1].offsetLeft - first.offsetLeft - first.offsetWidth : 0;
            const stepSize = first.offsetWidth + gap;

            // Trouve la carte active actuelle en comparant avec le début du rail normalisé
            let current = 0;
            const scrollThreshold = rail.scrollLeft + (stepSize / 2);
            for (let i = 0; i < list.length; i++) 
            {
                const relativeLeft = list[i].offsetLeft - firstOffset;
                if (relativeLeft <= scrollThreshold) {
                    current = i;
                }
            }

            // Carte cible encadrée entre le début et la fin de la liste
            const target = Math.min(Math.max(current + direction, 0), list.length - 1);
            const maxScroll = rail.scrollWidth - rail.clientWidth;

            const left = target === list.length - 1 
                ? maxScroll 
                : (target === 0 ? 0 : list[target].offsetLeft - firstOffset);

            rail.scrollTo({ left, behavior: 'smooth' });
        }

        prev?.addEventListener('click', () => step(-1));
        next?.addEventListener('click', () => step(1));

        // --- 3. Drag with the mouse ---------------------------------------
        let dragging = false;
        let startX = 0;
        let startScroll = 0;

        rail.addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse' || e.button !== 0) return;

            dragging = true;
            lastDragDistance = 0;
            startX = e.clientX;
            startScroll = rail.scrollLeft;
            rail.classList.add('is-dragging');
        });

        rail.addEventListener('pointermove', (e) => {
            if (!dragging) return;

            const dx = e.clientX - startX;
            lastDragDistance = Math.max(lastDragDistance, Math.abs(dx));

            if (lastDragDistance > CLICK_TOLERANCE) {
                e.preventDefault();
                rail.scrollLeft = startScroll - dx;
            }
        });

        function stopDrag() {
            if (!dragging) return;
            dragging = false;
            rail.classList.remove('is-dragging');
            window.setTimeout(() => {
                lastDragDistance = 0;
            }, 0);
        }

        window.addEventListener('pointerup', stopDrag);
        window.addEventListener('pointercancel', stopDrag);
        window.addEventListener('blur', stopDrag);

        if (!window.__railClickGuard) {
            window.__railClickGuard = true;
            window.addEventListener(
                'click',
                (e) => {
                    if (lastDragDistance <= CLICK_TOLERANCE) return;
                    e.preventDefault();
                    e.stopPropagation();
                },
                { capture: true }
            );
        }

        // --- 4. Keyboard ---------------------------------------------------
        rail.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') {
                e.preventDefault();
                step(-1);
            }
            if (e.key === 'ArrowRight') {
                e.preventDefault();
                step(1);
            }
        });
    });
</script>

<style>
	.rail-block {
		/* Nothing fancy: the rail, then the arrows below it. */
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	/* --- The scroller ---------------------------------------------------- */
	.rail {
		display: flex;
		gap: 18px;
		overflow-x: auto;
		overflow-y: hidden;
		padding: 4px 2px 8px;
		cursor: grab;
		/* Smooth scrolling on iOS. */
		-webkit-overflow-scrolling: touch;
		/* Do not trigger the browser's "swipe back" gesture. */
		overscroll-behavior-x: contain;

		/* --- NO VISIBLE SCROLLBAR ---------------------------------------
		   Firefox / standard: */
		scrollbar-width: none;
	}

	/* Chrome, Safari, Edge: */
	.rail::-webkit-scrollbar {
		width: 0;
		height: 0;
		display: none;
	}

	/* Old Edge / IE: */
	.rail {
		-ms-overflow-style: none;
	}

	.rail.is-dragging {
		cursor: grabbing;
		/* No text selection, no image ghost, while dragging. */
		user-select: none;
	}

	/* Keyboard focus on the rail itself. */
	.rail:focus-visible {
		outline: 2px solid var(--c-primary);
		outline-offset: 4px;
		border-radius: var(--r-sm);
	}

	/* --- The arrows ------------------------------------------------------ */
	.rail-controls {
		display: flex;
		justify-content: center;
		gap: 10px;
	}

	.rail-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 34px;
		border: 1px solid var(--c-border-strong);
		border-radius: var(--r-sm);
		background: var(--c-surface);
		color: var(--c-text);
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.rail-btn svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.rail-btn:hover:not(:disabled) {
		border-color: var(--c-primary);
		color: var(--c-primary);
	}

	.rail-btn:focus-visible {
		outline: 2px solid var(--c-primary);
		outline-offset: 2px;
	}

	.rail-btn:disabled {
		opacity: 0.4;
		cursor: default;
	}

</style>

<!--
  -----------------------------------------------------------------------
  Second style block, WITHOUT scoping (is:global).
  -----------------------------------------------------------------------
  The rules above are scoped: Astro adds a data-astro-cid-xxxx attribute to
  every selector AND to every element this component renders. The cards are
  rendered by ProjectCard.astro, so they carry ITS attribute, not this one:
  a scoped `.rail > .card` can never match them.

  That is why everything the rail needs to say about the cards lives here,
  in an unscoped block. The selectors stay precise (always starting with
  `.rail`) so they cannot leak into the grid of the /projects page.
-->
<style is:global>
	/* Each card keeps its width and never shrinks: that is what makes the row
	   scroll sideways, and what gives the arrows a fixed step to move by. */
	.rail > .card {
		flex: 0 0 300px;
		width: 300px;
	}

	/* While dragging, the whole rail shows the "grabbing" hand. */
	.rail.is-dragging,
	.rail.is-dragging .card,
	.rail.is-dragging .card-link {
		cursor: grabbing;
	}

	/* The images must not start their own drag (the browser's "drag this
	   picture" ghost would swallow the mouse events). pointer-events: none
	   also makes the click land on the link instead of on the image. */
	.rail img {
		-webkit-user-drag: none;
		user-drag: none;
		pointer-events: none;
	}

	/* --- Small screens --------------------------------------------------- */
	@media (max-width: 640px) {
		.rail > .card {
			flex-basis: 260px;
			width: 260px;
		}
	}
</style>
