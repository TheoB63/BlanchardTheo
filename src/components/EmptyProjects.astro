---
// ==========================================================================
// EmptyProjects.astro — the message shown when no project is detected.
// --------------------------------------------------------------------------
// You should never see this on a finished site. It exists because "my projects
// do not show up" is the one problem worth explaining on the page itself
// instead of in a console nobody reads.
//
// Used by src/pages/index.astro and src/pages/projects/index.astro.
// The texts are in src/i18n/translations/projects.ts.
// ==========================================================================
import Bilingual from './Bilingual.astro';
---

<div class="empty">
	<p class="empty-title"><Bilingual k="projects.empty" /></p>
	<p class="empty-hint"><Bilingual k="projects.emptyHint" /></p>
</div>

<style>
	.empty {
		border: 1px dashed #cfc5e2;
		border-radius: 4px;
		background: #fbfaff;
		padding: 18px 20px;
		max-width: 62ch;
	}

	.empty-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
	}

	.empty-hint {
		margin: 8px 0 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: #6b6478;
	}
</style>
