---
// ==========================================================================
// BaseLayout.astro — the shell of every page: <html>, header, footer.
// --------------------------------------------------------------------------
// WHAT IS IN HERE
//   1. the theme: this is where the colours and sizes of src/theme.ts are
//      turned into CSS variables, once and for all (see `themeCss` below).
//      That is why no component ever writes a colour by hand.
//   2. the sticky header: your name on the left, the menu in the middle, the
//      FR / EN switch on the right. The menu is built from `menu` in
//      src/site.ts and each button scrolls to a section of the one-page home
//      (#home / #about / #projects).
//   3. the footer, on EVERY page (including the markdown ones).
//   4. the global CSS: the smooth scrolling of the anchors, the width of the
//      columns, and the rules that make the bilingual system work.
//
// Props (all optional):
//   title                 one title for the browser tab
//   title_fr / title_en   one title per language: the tab then follows the
//                         FR / EN switch
// ==========================================================================
import LangSwitch from '../components/LangSwitch.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteName, menu } from '../site';
import { theme, themeCss } from '../theme';

interface Props {
	/** Text of the browser tab. Defaults to your name. */
	title?: string;
	/** Or one title per language: the tab then follows the FR/EN switch. */
	title_fr?: string;
	title_en?: string;
}

const { title = siteName, title_fr, title_en } = Astro.props;

// When both are given, they are written on <html> as data attributes and
// src/i18n/i18n.js copies the right one into document.title.
const hasBilingualTitle = Boolean(title_fr && title_en);
---

<!-- data-lang is the master switch of the whole i18n system. It starts at the
     default language and is updated by the script in <head> below, then by
     src/i18n/i18n.js when you click FR or EN. -->
<html
	lang="en"
	data-lang="en"
	data-title-fr={hasBilingualTitle ? title_fr : undefined}
	data-title-en={hasBilingualTitle ? title_en : undefined}
>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- The font comes from src/theme.ts (`font.googleUrl`), so you can
		     change the whole site's typeface from that one line. -->
		<link href={theme.font.googleUrl} rel="stylesheet" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{hasBilingualTitle ? title_en : title}</title>

		<!-- ==================================================================
		     THE THEME
		     src/theme.ts turns your colours and sizes into a block of CSS
		     variables and prints it here, once, in the <head> of every page:

		         :root { --c-primary: #7a49c5; --header-h: 60px; ... }

		     Every component then uses var(--c-primary), var(--header-h)...
		     That is the "one place to change everything" you asked for: edit
		     src/theme.ts, save, and the whole site follows.
		     `set:html` means "write this string as HTML, do not treat it as a
		     file to process".
		     ================================================================== -->
		<style is:global set:html={themeCss}></style>

		<!-- Runs before the page is painted, so the visitor never sees a flash
		     of the wrong language. `is:inline` = Astro copies it as it is. -->
		<script is:inline>
			(function () {
				var lang = 'en';
				try {
					var saved = localStorage.getItem('lang');
					if (saved === 'fr' || saved === 'en') {
						lang = saved;
					} else if ((navigator.language || 'en').toLowerCase().indexOf('fr') === 0) {
						lang = 'fr';
					}
				} catch (e) {
					/* private browsing: keep the default */
				}
				var root = document.documentElement;
				root.setAttribute('data-lang', lang);
				root.setAttribute('lang', lang);
				// Keep the browser tab in the chosen language too.
				var t = root.getAttribute('data-title-' + lang);
				if (t) document.title = t;
			})();
		</script>
	</head>
	<body>
		<!-- ==================================================================
		     THE HEADER
		     `position: sticky` keeps it at the top while you scroll the
		     one-page site, so the menu is always one click away from any
		     section.
		     The brand is a LINK back to the top of the home page, not a title:
		     the <h1> of the site is your name in the hero (Hero.astro) — one
		     <h1> per page is better for search engines and screen readers.
		     ================================================================== -->
		<header class="site-header">
			<a class="site-brand" href="/#home">{siteName}</a>

			<!-- The menu, built from `menu` in src/site.ts.
			     Each `anchor` ('#about') becomes '/#about': the same button works
			     from any page and always brings the visitor to the right
			     section of the home page.
			     `data-nav` is the id of the section: the small script at the
			     bottom of this file uses it to highlight the section you are
			     currently reading. -->
			<nav class="site-nav" data-i18n-aria="nav.menu">
				<ul>
					{
						menu.map((item) => (
							<li>
								<a href={`/${item.anchor}`} data-nav={item.id}>
									<span lang="fr">{item.label.fr}</span>
									<span lang="en">{item.label.en}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<LangSwitch />
		</header>

		<main>
			<slot />
		</main>

		<SiteFooter />

		<!-- The language logic (buttons, aria-labels, saved choice). Imported
		     once here, so every page of the site gets it. -->
		<script>
			import '../i18n/i18n.js';
		</script>

		<!-- ==================================================================
		     The menu highlight ("scroll spy")
		     Adds .is-current to the menu button of the section you are looking
		     at. It only does something on the one-page home: on the other
		     pages there is no section with those ids, and the script stops.
		     ================================================================== -->
		<script>
			const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]'));

			// Keep only the buttons whose section exists on this page.
			const targets = navLinks
				.map((link) => document.getElementById(link.dataset.nav ?? ''))
				.filter((el): el is HTMLElement => el !== null);

			if (targets.length > 0) {
				const headerHeight = () => {
					const value = getComputedStyle(document.documentElement).getPropertyValue('--header-h');
					return Number.parseFloat(value) || 0;
				};

				let ticking = false;

				function updateCurrentSection() {
					ticking = false;

					// A line a bit below the header and a third of the way down the
					// screen: the section that crosses it is "the one you are in".
					const line = window.scrollY + headerHeight() + window.innerHeight * 0.3;

					let current: string | null = targets[0]?.id ?? null;
					for (const section of targets) {
						if (section.getBoundingClientRect().top + window.scrollY <= line) current = section.id;
					}

					navLinks.forEach((link) => {
						const isCurrent = link.dataset.nav === current;
						link.classList.toggle('is-current', isCurrent);
						link.setAttribute('aria-current', isCurrent ? 'true' : 'false');
					});
				}

				// rAF throttle: the calculation runs at most once per frame,
				// even if the visitor scrolls with a trackpad at high speed.
				function onScroll() {
					if (ticking) return;
					ticking = true;
					window.requestAnimationFrame(updateCurrentSection);
				}

				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll);
				updateCurrentSection();
			}
		</script>
	</body>
</html>

<style>
	/* ==================================================================
	   The header.
	   ================================================================== */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		height: var(--header-h);
		padding: 0 20px;
		box-sizing: border-box;
		background: var(--c-header-bg);
		/* The blur is what makes the header readable when it slides over the
		   hero pictures. Harmless where it is not supported. */
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--c-border-soft);
	}

	.site-brand {
		font-size: 1.1em;
		font-weight: 500;
		white-space: nowrap;
		color: var(--c-text);
		text-decoration: none;
	}

	.site-brand:hover {
		color: var(--c-primary);
	}

	.site-nav ul {
		display: flex;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav a {
		position: relative;
		display: inline-block;
		padding: 6px 10px;
		color: var(--c-text);
		font-size: 0.95rem;
		text-decoration: none;
	}

	/* The purple bar under the current section's button. It grows from the
	   middle, which is a nicer movement than a simple colour change. */
	.site-nav a::after {
		content: '';
		position: absolute;
		left: 10px;
		right: 10px;
		bottom: 0;
		height: 2px;
		border-radius: 2px;
		background: var(--c-primary);
		transform: scaleX(0);
		transition: transform 0.18s ease;
	}

	.site-nav a:hover::after {
		transform: scaleX(1);
	}

	.site-nav a.is-current {
		color: var(--c-primary);
	}

	.site-nav a.is-current::after {
		transform: scaleX(1);
	}

	.site-nav a:focus-visible,
	.site-brand:focus-visible {
		outline: 2px solid var(--c-primary);
		outline-offset: 2px;
	}

	/* Small screens: the menu wraps under the name, and stays scrollable if it
	   still does not fit. */
	@media (max-width: 700px) {
		.site-header {
			height: auto;
			flex-wrap: wrap;
			row-gap: 4px;
			padding: 8px 14px;
		}
		.site-nav {
			order: 3;
			width: 100%;
			overflow-x: auto;
		}
		.site-nav ul {
			justify-content: center;
		}
		.site-brand {
			font-size: 1em;
		}
		.site-nav a {
			padding: 4px 8px;
			font-size: 0.9rem;
		}
	}
</style>

<style is:global>
	/* ==================================================================
	   The <body> and the marks. Everything reads the variables printed by
	   src/theme.ts at the top of this file.
	   ================================================================== */
	* {
		font-family: var(--font-family);
	}

	html {
		/* The anchors of the menu (#about, #projects) glide instead of jumping.
		   `scroll-margin-top` on the sections (Section.astro) stops them from
		   landing under the sticky header. */
		scroll-behavior: smooth;
	}

	/* ...except for someone who asked the system to reduce animations. */
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	body {
		margin: 0;
		/* header at the top, content in the middle, footer at the bottom even
		   on a short page */
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background: var(--c-page);
		/* The colour is set HERE and not on `*` anymore, so the hero can be
		   white-text-on-picture without fighting a global rule. */
		color: var(--c-text);
	}

	main {
		flex: 1 0 auto;
	}

	/* ==================================================================
	   .content — the column used by the pages that are NOT the one-page
	   home: the CV (/cv), a project page (/projects/<name>) and the
	   markdown layouts. The sections of the home page use the same widths
	   through Section.astro.
	   ================================================================== */
	.content {
		width: 100%;
		max-width: var(--w-content);
		margin: 60px auto;
		padding: 0 20px;
		box-sizing: border-box;

		h2 {
			font-size: 1.8em;
		}
		p {
			font-size: 1.2em;
		}
	}

	/* ==================================================================
	   i18n — the three rules that make the whole system work.
	   ------------------------------------------------------------------
	   Both languages are always in the HTML. The current language is
	   written on <html> as data-lang, and these rules hide everything that
	   is not in that language:
	     - any element with lang="fr" / lang="en" (components, markdown)
	     - any element with the class "bilingual"
	     - [hidden], used by the scripts to remove something from the page
	   If data-lang is missing for any reason, English is shown (default).
	   ================================================================== */
	[data-lang='fr'] [lang='en']:not(html),
	[data-lang='en'] [lang='fr']:not(html),
	[data-lang='fr'] .bilingual[lang='en'],
	[data-lang='en'] .bilingual[lang='fr'] {
		display: none !important;
	}
	html:not([data-lang]) [lang='fr'] {
		display: none !important;
	}
	[hidden] {
		display: none !important;
	}

	/* The two spans of Bilingual.astro sit next to each other; only one is
	   visible, so they must not add any spacing of their own. */
	.bilingual {
		display: inline;
	}

	/* ==================================================================
	   Markdown bodies (project pages, CV) reuse the same typography as the
	   rest of the site.
	   ================================================================== */
	.content img {
		max-width: 100%;
		height: auto;
	}
	.content pre {
		background: var(--c-tint);
		border: 1px solid var(--c-border);
		border-radius: var(--r-sm);
		padding: 14px 16px;
		overflow-x: auto;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.content code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.9em;
	}
	.content p code {
		background: var(--c-tint);
		border: 1px solid var(--c-border);
		border-radius: var(--r-xs);
		padding: 1px 5px;
	}
	.content blockquote {
		margin: 1em 0;
		padding: 2px 0 2px 16px;
		border-left: 3px solid var(--c-border-accent);
		color: var(--c-text-muted);
	}
	.content table {
		border-collapse: collapse;
		width: 100%;
		font-size: 1rem;
	}
	.content th,
	.content td {
		border: 1px solid var(--c-border);
		padding: 8px 10px;
		text-align: left;
	}
	.content th {
		background: var(--c-tint);
	}
</style>
